# ==========================================
# Environment Variables Example Configuration
# Copy this file to .env and configure real values for deployment.
# NEVER commit the real .env file with secrets to Git.
# ==========================================

# Active Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=work_management
DB_USERNAME=workuser
DB_PASSWORD=workpassword_change_me
DB_URL=jdbc:mysql://mysql:3306/work_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# MySQL Root Password (Used by Docker Compose for MySQL container initialization)
MYSQL_ROOT_PASSWORD=rootpassword_change_me

# JWT Authentication (Minimum 32 characters / 256 bits)
JWT_SECRET=ReplaceWithAStrongSecretKeyAtLeast32BytesLong2026!
JWT_EXPIRATION_MS=3600000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Swagger Documentation in Production (true/false)
SWAGGER_ENABLED=false

# CORS & Cookie Security
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax

